+        int safeTopN = (topN == null || topN <= 0) ? 20 : Math.min(topN, 50);
+
+        List<String> noteIds = searchNotes(knowledgeId, queryText, safeTopN);
+        if (noteIds.isEmpty()) {
+            return Collections.emptyList();
+        }
+
+        Integer tenantId = getCurrentTenantId();
+        List<String> scopedNoteIds = filterByScope(noteIds, safeScope, currentUserId, tenantId);
+        if (scopedNoteIds.isEmpty()) {
+            return Collections.emptyList();
+        }
+
+        List<Map<String, Object>> docs = embeddingHandler.searchEmbedding(knowledgeId, queryText, safeTopN, null, null);
+        Map<String, Map<String, Object>> docMap = new LinkedHashMap<>();
+        for (Map<String, Object> doc : docs) {
+            String noteId = oConvertUtils.getString(doc.get(EmbeddingHandler.EMBED_STORE_METADATA_DOCNAME));
+            if (oConvertUtils.isNotEmpty(noteId) && !docMap.containsKey(noteId)) {
+                docMap.put(noteId, doc);
+            }
+        }
+
+        List<SemanticSearchResultDTO> baseRows =
+                ainoteNoteMapper.selectSemanticResultBaseByNoteIds(scopedNoteIds, tenantId);
+        if (baseRows == null || baseRows.isEmpty()) {
+            return Collections.emptyList();
+        }
+
+        Map<String, SemanticSearchResultDTO> rowMap = baseRows.stream()
+                .filter(Objects::nonNull)
+                .collect(Collectors.toMap(SemanticSearchResultDTO::getNoteId, row -> row, (a, b) -> a));
+
+        List<SemanticSearchResultDTO> result = new ArrayList<>();
+        for (String noteId : scopedNoteIds) {
+            SemanticSearchResultDTO dto = rowMap.get(noteId);
+            if (dto == null) {
+                continue;
+            }
+            Map<String, Object> doc = docMap.get(noteId);
+            if (doc != null) {
+                dto.setSnippet(buildSnippet(oConvertUtils.getString(doc.get("content"), "")));
+                dto.setScore(toDouble(doc.get("score")));
+            }
+            result.add(dto);
+        }
+        return result;
