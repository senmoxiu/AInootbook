+        if (oConvertUtils.isEmpty(knowledgeId)) {
+            throw new JeecgBootException("知识库ID不能为空");
+        }
+        if (oConvertUtils.isEmpty(queryText)) {
+            throw new JeecgBootException("查询内容不能为空");
+        }
