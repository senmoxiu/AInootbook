+            return Result.error("ALL 范围仅管理员可用");
+        }
+        if (searchScope == NoteSearchScope.COURSE
+                && !roles.contains("admin")
+                && !roles.contains("teacher")) {
+            return Result.error("COURSE 范围仅教师可用");
+        }
+
+        int safeTopN = (topN == null || topN <= 0) ? 20 : Math.min(topN, 50);
