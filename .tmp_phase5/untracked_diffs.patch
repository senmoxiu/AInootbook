+    public Result<List<SemanticSearchResultDTO>> semanticSearchByScope(
+            @RequestParam(name = "q") String queryText,
+            @RequestParam(name = "scope", defaultValue = "personal") String scope,
+            @RequestParam(name = "topN", defaultValue = "20") Integer topN,
+            HttpServletRequest request) {
+        if (oConvertUtils.isEmpty(queryText)) {
+            return Result.error("查询内容不能为空");
+        }
+
+        LoginUser user = (LoginUser) SecurityUtils.getSubject().getPrincipal();
+        if (user == null) {
+            return Result.error("用户未登录");
+        }
+
+        NoteSearchScope searchScope;
+        try {
+            searchScope = NoteSearchScope.valueOf(scope.trim().toUpperCase(Locale.ROOT));
+        } catch (Exception e) {
+            return Result.error("scope 参数非法，支持 personal/public/course/all");
+        }
+
+        Set<String> roles = parseRoles(user.getRoleCode());
