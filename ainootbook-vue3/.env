# port
VITE_PORT = 3100

#  网站标题
VITE_GLOB_APP_TITLE = AI 课堂笔记智能整理系统

# 简称，此变量只能是字符/下划线
VITE_GLOB_APP_SHORT_NAME = AInootbook

# 应用版本号（bump 此值可使旧菜单缓存失效）
VITE_GLOB_APP_VERSION = 1.1.0

# 单点登录服务端地址
VITE_GLOB_APP_CAS_BASE_URL=http://cas.test.com:8443/cas

# 是否开启单点登录
VITE_GLOB_APP_OPEN_SSO = false

# 开启微前端模式
VITE_GLOB_APP_OPEN_QIANKUN=true

# 文件预览地址
VITE_GLOB_ONLINE_VIEW_URL=http://127.0.0.1:8012/onlinePreview


